# agentmem configuration template. Copy to .env and adjust:
#   cp .env.example .env
#
# .env is gitignored and is the only configuration file. Values here are
# placeholders: never put real credentials in a versioned file. Process
# environment variables override .env, and AGENTMEM_PG_DSN can be injected
# entirely at runtime.
#
# Docker Compose consumes this file twice: for ${...} interpolation and as
# env_file for the agentmem service. Unknown AGENTMEM_* keys are a hard error.
# All supported keys are listed below.

# --- Docker Compose / PostgreSQL container (placeholders only) ---
# These are placeholders, never real credentials. Set a strong POSTGRES_PASSWORD
# in the untracked .env before deploying.
POSTGRES_DB=agentmem
POSTGRES_USER=agentmem
POSTGRES_PASSWORD=change-me

# --- Server ---
AGENTMEM_ADDR=127.0.0.1:8080
AGENTMEM_MODE=dev
# production requires AGENTMEM_PG_DSN; dev falls back to the offline fake.

# --- OKF+Git ---
AGENTMEM_GIT_ROOT=./data/bundle
AGENTMEM_GIT_AUTHOR_NAME=agentmem
AGENTMEM_GIT_AUTHOR_EMAIL=agentmem@localhost

# --- PostgreSQL / GORM ---
# Leave empty for offline dev. Compose example (host `postgres`):
# Production requires TLS; sslmode=disable is rejected at validation time.
# AGENTMEM_PG_DSN=postgres://agentmem:change-me@postgres:5432/agentmem?sslmode=require
AGENTMEM_PG_DSN=
AGENTMEM_VECTOR_DSN=
AGENTMEM_PG_MAX_OPEN_CONNS=25
AGENTMEM_PG_MAX_IDLE_CONNS=10
AGENTMEM_PG_CONN_MAX_LIFETIME=30m
AGENTMEM_PG_LOG_LEVEL=warn

# --- Smart router / System One ---
AGENTMEM_CONFLICT_POLICY=okf_wins
AGENTMEM_SYSTEMONE_ENDPOINT=
AGENTMEM_SYSTEMONE_TIMEOUT_MS=5000
AGENTMEM_SYSTEMONE_CACHE_CAPACITY=256
AGENTMEM_SYSTEMONE_MAX_CHOICES=255
AGENTMEM_SYSTEMONE_MIN_CONFIDENCE=0.5
AGENTMEM_SYSTEMONE_FALLBACK=okf
# Fail-closed routing is unconditional and cannot be configured off.

# --- Attested Computation (0 selects the built-in default: 5000 ms / 100 rows) ---
AGENTMEM_COMPUTE_TIMEOUT_MS=5000
AGENTMEM_COMPUTE_MAX_ROWS=100

# --- Adapters as a JSON array ---
# Each engine plugin owns a plugin.yaml declaring its sdk_boundary.
# An empty endpoint selects the deterministic offline mock.
AGENTMEM_ADAPTERS='[{"name":"okf","kind":"okf","enabled":true},{"name":"memory","kind":"memory","enabled":true},{"name":"pgvector","kind":"pgvector","enabled":false},{"name":"llamaindex","kind":"llamaindex","enabled":false},{"name":"pageindex","kind":"pageindex","enabled":false},{"name":"graphrag","kind":"graphrag","enabled":false},{"name":"lightrag","kind":"lightrag","enabled":false}]'

# --- ACL ---
AGENTMEM_ACL_DEFAULT_VISIBILITY=private
AGENTMEM_ACL_DEFAULT_OWNER=system

# --- Authentication and permissions ---
# production requires AGENTMEM_AUTH_ENABLED=true and at least one token.
# Each token stores ONLY the SHA-256 digest of the bearer value; never put a
# raw token here. Scopes: health:read, knowledge:read, knowledge:write,
# migrate:run, audit:read, compute:run.
# Generate a digest with: printf %s 'your-token' | sha256sum
AGENTMEM_AUTH_ENABLED=false
AGENTMEM_AUTH_TOKENS=
# Comma-separated origins allowed on cross-site writes (empty = no cross-origin).
AGENTMEM_ALLOWED_ORIGINS=
# e.g. https://console.example.com

# --- Outbound hosts (SSRF allowlist) ---
# Required whenever a non-empty HTTP endpoint is configured (System One or a
# non-cli adapter). Bare hosts only; '*.example.com' matches subdomains.
AGENTMEM_EGRESS_ALLOWED_HOSTS=

# --- Per-client rate limit (single process, in memory) ---
AGENTMEM_RATE_RPS=20
AGENTMEM_RATE_BURST=40

# --- Optional: alternate env file path ---
# AGENTMEM_ENV_FILE=/path/to/.env

# --- Optional: real PostgreSQL for the integration test ---
# Only read by TestPostgresIntegration; leave commented for offline runs.
# AGENTMEM_TEST_PG_DSN=
